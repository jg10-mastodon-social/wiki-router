{
  "_comment": "Expected outcomes for archive.org book resolution; payloads are synthetic. Each response maps an API URL to a file under tests/fixtures/metadata/. A URL absent from the map raises, so no case can silently reach the network.",
  "cases": [
    {
      "note": "archive record without an ISBN: chrome stripped, archive data passed through",
      "url": "https://archive.org/details/syntheticbook01",
      "responses": {
        "https://archive.org/metadata/syntheticbook01": "book/archive-no-isbn.json"
      },
      "expects": {
        "ok": true,
        "final_url": "https://archive.org/details/syntheticbook01",
        "title": "Tidewater Almanac",
        "description": "",
        "source": "archive.org",
        "creator": "Mira Vell",
        "date": "1974",
        "isbn": "",
        "canonical": "",
        "title_noisy": false,
        "error": ""
      }
    },
    {
      "note": "valid ISBN with an Open Library record: Open Library wins",
      "url": "https://archive.org/details/syntheticbook02",
      "responses": {
        "https://archive.org/metadata/syntheticbook02": "book/archive-with-isbn.json",
        "https://openlibrary.org/api/books?bibkeys=ISBN:9798999000019&format=json&jscmd=data": "book/openlibrary-record.json"
      },
      "expects": {
        "ok": true,
        "final_url": "https://archive.org/details/syntheticbook02",
        "title": "The Lantern Makers: a study of coastal workshops",
        "source": "openlibrary",
        "creator": "Oren Pell; Inez Sable",
        "date": "2011",
        "isbn": "9798999000019",
        "canonical": "https://openlibrary.org/isbn/9798999000019",
        "error": ""
      }
    },
    {
      "note": "valid ISBN Open Library does not know: archive data falls back in",
      "url": "https://archive.org/details/syntheticbook03",
      "responses": {
        "https://archive.org/metadata/syntheticbook03": "book/archive-unknown-isbn.json",
        "https://openlibrary.org/api/books?bibkeys=ISBN:9798999000026&format=json&jscmd=data": "book/openlibrary-missing.json"
      },
      "expects": {
        "ok": true,
        "title": "Salt Marsh Ledger",
        "source": "archive.org",
        "creator": "Toma Rill",
        "date": "1988",
        "isbn": "9798999000026",
        "canonical": "",
        "error": ""
      }
    },
    {
      "note": "chrome suffix repeated twice is stripped repeatedly",
      "url": "https://archive.org/details/syntheticbook04",
      "responses": {
        "https://archive.org/metadata/syntheticbook04": "book/archive-doubled-chrome.json"
      },
      "expects": {
        "ok": true,
        "title": "Pale Dune Survey",
        "source": "archive.org",
        "creator": "Rae Quill",
        "date": "1962",
        "canonical": ""
      }
    },
    {
      "note": "trailing author and date tail is removed",
      "url": "https://archive.org/details/syntheticbook05",
      "responses": {
        "https://archive.org/metadata/syntheticbook05": "book/archive-author-tail.json"
      },
      "expects": {
        "ok": true,
        "title": "Harbor Light Notes",
        "source": "archive.org",
        "creator": "Ada Thorne",
        "date": "1954"
      }
    },
    {
      "note": "archive record missing entirely",
      "url": "https://archive.org/details/absentinventory",
      "responses": {},
      "expects": {
        "ok": false,
        "final_url": "https://archive.org/details/absentinventory",
        "title": "",
        "source": "",
        "creator": "",
        "date": "",
        "isbn": "",
        "canonical": "",
        "error": "no archive record"
      }
    },
    {
      "note": "invalid ISBN checksum is not sent to Open Library",
      "url": "https://archive.org/details/syntheticbook07",
      "responses": {
        "https://archive.org/metadata/syntheticbook07": "book/archive-invalid-isbn.json",
        "https://openlibrary.org/api/books?bibkeys=ISBN:9798999000065&format=json&jscmd=data": "book/openlibrary-poison.json"
      },
      "expects": {
        "ok": true,
        "title": "Quarry Songs",
        "source": "archive.org",
        "creator": "Pim Ost",
        "date": "2001",
        "isbn": "",
        "canonical": ""
      }
    },
    {
      "note": "archive details URL never reaches the HTML getter",
      "url": "https://archive.org/details/syntheticbook08",
      "responses": {
        "https://archive.org/metadata/syntheticbook08": "book/archive-guarded.json"
      },
      "expects": {
        "ok": true,
        "title": "Signal Fires of the Fens",
        "source": "archive.org",
        "creator": "Lena Marr",
        "date": "1990"
      }
    },
    {
      "note": "publisher page on a book-ish host: valid ISBN-13 resolves through Open Library",
      "url": "https://press.bookshop.example/tidewater-almanac",
      "html": "book/publisher-isbn13.html",
      "responses": {
        "https://openlibrary.org/api/books?bibkeys=ISBN:9780000000019&format=json&jscmd=data": "book/openlibrary-tidewater.json"
      },
      "expects": {
        "ok": true,
        "final_url": "https://press.bookshop.example/tidewater-almanac",
        "title": "Tidewater Almanac: a coastal field guide",
        "description": "",
        "source": "openlibrary",
        "creator": "Mira Vell",
        "date": "1974",
        "isbn": "9780000000019",
        "canonical": "https://openlibrary.org/isbn/9780000000019",
        "title_noisy": false,
        "error": ""
      }
    },
    {
      "note": "hyphenated ISBN-10 in page text is normalised, checksum-validated and resolved",
      "url": "https://press.bookshop.example/lantern-makers",
      "html": "book/publisher-isbn10.html",
      "responses": {
        "https://openlibrary.org/api/books?bibkeys=ISBN:0000000019&format=json&jscmd=data": "book/openlibrary-lantern.json"
      },
      "expects": {
        "ok": true,
        "title": "The Lantern Makers: a study of coastal workshops",
        "description": "",
        "source": "openlibrary",
        "creator": "Oren Pell; Inez Sable",
        "date": "2011",
        "isbn": "0000000019",
        "canonical": "https://openlibrary.org/isbn/0000000019",
        "error": ""
      }
    },
    {
      "note": "invalid checksum on a book-ish host stays on the HTML title; a lookup would hit the poison record",
      "url": "https://press.bookshop.example/quarry-songs",
      "html": "book/publisher-invalid-isbn.html",
      "responses": {
        "https://openlibrary.org/api/books?bibkeys=ISBN:9780000000034&format=json&jscmd=data": "book/openlibrary-poison-invalid.json"
      },
      "expects": {
        "ok": true,
        "title": "Quarry Songs",
        "description": "Collected verse from an invented quarry town.",
        "source": "html",
        "creator": "",
        "date": "",
        "isbn": "",
        "canonical": "",
        "title_noisy": false,
        "error": ""
      }
    },
    {
      "note": "an essay that merely cites a valid ISBN is not hijacked; the poison record fails any lookup",
      "url": "https://journal.example.com/essays/field-notes",
      "html": "book/journal-cites-isbn.html",
      "responses": {
        "https://openlibrary.org/api/books?bibkeys=ISBN:9780000000040&format=json&jscmd=data": "book/openlibrary-poison-citation.json"
      },
      "expects": {
        "ok": true,
        "title": "Field Notes on Reading",
        "description": "An essay that cites an edition number.",
        "source": "html",
        "creator": "",
        "date": "",
        "isbn": "",
        "canonical": "",
        "error": ""
      }
    },
    {
      "note": "noisy title on a non-book host still takes the ISBN path",
      "url": "https://portal.example.net/edition/8821",
      "html": "book/access-denied.html",
      "responses": {
        "https://openlibrary.org/api/books?bibkeys=ISBN:9780000000057&format=json&jscmd=data": "book/openlibrary-access.json"
      },
      "expects": {
        "ok": true,
        "title": "Salt Marsh Ledger: notes from a tidal year",
        "description": "",
        "source": "openlibrary",
        "creator": "Toma Rill",
        "date": "1988",
        "isbn": "9780000000057",
        "canonical": "https://openlibrary.org/isbn/9780000000057",
        "title_noisy": false,
        "error": ""
      }
    },
    {
      "note": "/books/ in the path makes an otherwise unknown host book-ish",
      "url": "https://catalogue.example.org/books/pale-dune-survey",
      "html": "book/catalogue-books-path.html",
      "responses": {
        "https://openlibrary.org/api/books?bibkeys=ISBN:9780000000064&format=json&jscmd=data": "book/openlibrary-salt.json"
      },
      "expects": {
        "ok": true,
        "title": "Pale Dune Survey: a field atlas",
        "source": "openlibrary",
        "creator": "Rae Quill",
        "date": "1962",
        "isbn": "9780000000064",
        "canonical": "https://openlibrary.org/isbn/9780000000064",
        "error": ""
      }
    }
  ]
}
